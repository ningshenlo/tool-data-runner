FROM node:24.14.0-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY report-runtime/scripts/reports/requirements.txt /tmp/report-requirements.txt
RUN pip install --no-cache-dir -r /tmp/report-requirements.txt
COPY report-runtime/ /app/
COPY scripts/sync-report-runtime.py /tmp/verify-report-runtime.py
ENV REPORT_PYTHON=python \
    REPORT_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc \
    REPORT_EXPORT_ROOT=/exports \
    REPORT_RUNTIME_VERSION=linux-matplotlib-3.10.6-v1 \
    REPORT_DRAFT_ONLY=1 \
    MPLCONFIGDIR=/app/work/reports/.matplotlib \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN python /tmp/verify-report-runtime.py --verify --target /app \
    && node scripts/reports/pipeline.mjs --help \
    && python -c "import os,matplotlib; from pathlib import Path; assert matplotlib.__version__ == '3.10.6'; assert Path(os.environ['REPORT_FONT']).is_file(); assert Path(os.environ['REPORT_FONT'].replace('-Regular','-Bold')).is_file()"
CMD ["python", "scripts/reports/draft-worker.py"]
