# Production taxonomy automation. Disable with 0 as an emergency kill switch.
TAXONOMY_AUTO_ENABLED=1
# Use the persistent OpenAI Batch API pipeline. Set 0 only to roll back to the
# previous synchronous Browser Rendering custom-AI taxonomy implementation.
TAXONOMY_BATCH_ENABLED=1
# Known-incident paid rechecks are frozen by default. Enable only for an
# explicitly approved cohort after rollback/apply safety gates pass.
TAXONOMY_RECHECK_AUTO_NON_PRODUCT=0
RUNNER_TAXONOMY_LIMIT=50
RUNNER_TAXONOMY_INTERVAL_SECONDS=300
