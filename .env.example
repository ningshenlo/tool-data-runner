TAXONOMY_AUTO_ACCEPT_CONFIDENCE=0.50
# Claims v2 is opt-in. Publish must remain disabled until Shadow acceptance gates pass.
PRICING_CLAIMS_SHADOW=0
PRICING_CLAIMS_PUBLISH=0
# Maximum legacy manual_review tasks replayed per pricing batch after new work.
RUNNER_PRICING_MANUAL_REVIEW_REPLAY_LIMIT=5
